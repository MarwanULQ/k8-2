# GENERATED BY TERRAFORM (infra/inventory.tf). Do not edit; changes are overwritten on apply.

[control_plane]
master ansible_host=${master.ip} node_name=${master.name}

[workers]
%{ for key, w in workers ~}
${key} ansible_host=${w.ip} node_name=${w.name}
%{ endfor ~}

[k8s_nodes:children]
control_plane
workers

[k8s_nodes:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=~/.ssh/${key_name}.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -i ~/.ssh/${key_name}.pem -o StrictHostKeyChecking=accept-new -W %h:%p -q ubuntu@${bastion_ip}"'
